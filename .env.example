# Settings for `docker compose`. Copy this file to a file named .env (same folder) and fill it in.
# The .env file is private and is never committed to Git.

# The database login. Use only letters and numbers in the password: other characters break the database address.
POSTGRES_USER=enersync
POSTGRES_PASSWORD=change-me-to-letters-and-numbers
POSTGRES_DB=enersync

# The secret that signs login tokens. Make a long random one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-value

# Optional
# JWT_EXPIRE_MINUTES=60
# VITE_API_URL=http://localhost:8000

# Optional: extra web addresses allowed to call the API, separated by commas (used when hosted online).
# CORS_ORIGINS=https://your-web-app.example.com
